{
  "name": "contentgate",
  "version": "0.1.0",
  "description": "Framework-agnostic, server-side content authorization using Web Request and Response.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "adapters",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p examples/nextjs-blog/tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "demo": "npm run build && npm run dev --workspace examples/nextjs-blog",
    "demo:build": "npm run build && npm run build --workspace examples/nextjs-blog",
    "test:demo": "npm run demo:build && node scripts/verify-demo.mjs",
    "prepack": "npm run build"
  },
  "workspaces": [
    "examples/nextjs-blog"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
